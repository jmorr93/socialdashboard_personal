# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Metricool API (find these in Metricool → Account Settings → API tab)
METRICOOL_USER_TOKEN=your-metricool-user-token
METRICOOL_USER_ID=your-metricool-user-id
METRICOOL_BLOG_ID=your-metricool-blog-id

# Cron secret (for protecting cron endpoints)
CRON_SECRET=your-random-secret-here
